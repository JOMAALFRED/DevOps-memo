{
  "id": null,
  "uid": "devops-memo-argo-rollouts",
  "title": "DevOps Memo - Argo Rollouts",
  "tags": ["devops", "kubernetes", "argo-rollouts", "canary", "blue-green"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Phase et strategie du Rollout",
      "description": "Phase actuelle et strategie utilisee par Argo Rollouts",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rollout_info{namespace=\"memo-saas\"}",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 2,
      "title": "Repliques du Rollout",
      "description": "Evolution des replicas souhaites, disponibles, mis a jour et indisponibles",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"rollout_info_replicas_(desired|available|updated|unavailable)\",namespace=\"memo-saas\",name=\"dental-saas-frontend\"}",
          "legendFormat": "{{__name__}}",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Disponibilite du Rollout",
      "description": "Pourcentage de replicas disponibles par rapport aux replicas souhaites",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rollout_info_replicas_available{namespace=\"memo-saas\",name=\"dental-saas-frontend\"} / clamp_min(rollout_info_replicas_desired{namespace=\"memo-saas\",name=\"dental-saas-frontend\"}, 1)",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        }
      }
    }
  ]
}